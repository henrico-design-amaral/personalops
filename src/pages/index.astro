---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const weekDays = [
  { day: 'MON', value: '92%', tone: 'success' },
  { day: 'TUE', value: '76%', tone: 'violet' },
  { day: 'WED', value: '88%', tone: 'success' },
  { day: 'THU', value: '64%', tone: 'gold' },
  { day: 'FRI', value: '71%', tone: 'violet' },
  { day: 'SAT', value: '45%', tone: 'gold' },
  { day: 'SUN', value: '—', tone: 'rest' },
];
---

<BaseLayout
  title="PersonalOps — Reflective Signal"
  description="A personal system for turning intention into movement through plan, focus, execution and reflection."
  pageClass="marketing-page reflective-landing"
>
  <header class="site-header reflective-header">
    <a class="wordmark" href={base} aria-label="PersonalOps, início">personal<span>ops</span></a>
    <nav aria-label="Navegação principal">
      <a href="#patterns">Patterns</a>
      <a href="#tone">Tone</a>
      <a class="header-action" href={`${base}entrar/`}>Entrar</a>
    </nav>
  </header>

  <main id="conteudo" class="guide-shell">
    <section class="hero-guide" aria-labelledby="reflective-title">
      <div class="hero-kicker">
        <span>PersonalOps / System Guide</span>
        <span>V 1.0 / May 2025</span>
      </div>
      <div class="hero-grid">
        <div>
          <p class="section-code">01 / Signal</p>
          <h1 id="reflective-title">PERSONALOPS / REFLECTIVE SIGNAL</h1>
          <p class="hero-lead">A personal system for turning intention into movement.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={`${base}entrar/`}>Abrir meu sistema</a>
            <a class="text-link" href="#patterns">Ver o sistema</a>
          </div>
        </div>
        <aside class="plan-mark" aria-label="Ritmo PersonalOps">
          <strong>/</strong>
          <span>Plan</span>
          <span>Focus</span>
          <span>Execute</span>
          <span>Reflect</span>
        </aside>
      </div>
    </section>

    <section class="color-system" aria-labelledby="color-title">
      <p class="section-code">02 / Color</p>
      <h2 id="color-title">Color marks intent.</h2>
      <div class="swatch-row" aria-label="Paleta PersonalOps">
        <article><i class="ink"></i><strong>Ink</strong><span>#1A1715</span></article>
        <article><i class="panel"></i><strong>Dark Panel</strong><span>#282321</span></article>
        <article><i class="surface"></i><strong>Silver</strong><span>#D8D2C9</span></article>
        <article><i class="violet"></i><strong>Electric Violet</strong><span>#A78BFA</span></article>
        <article><i class="gold"></i><strong>Solar Gold</strong><span>#FFC83D</span></article>
      </div>
      <div class="intent-grid">
        <div class="intent-band violet-band"><span>Electric Violet / #A78BFA</span><small>Focus · Plan · Reflect · Progress</small></div>
        <div class="intent-copy"><p>Violet marks plan, focus, reflection, and progress.</p></div>
        <div class="intent-band gold-band"><span>Solar Gold / #FFC83D</span><small>Priority · Milestone · Commitment</small></div>
        <div class="intent-copy"><p>Gold marks priority, milestone, and commitment.</p></div>
      </div>
    </section>

    <section class="patterns-section" id="patterns" aria-labelledby="patterns-title">
      <p class="section-code">03 / Personal Patterns</p>
      <h2 id="patterns-title">Plan with intent. Act with focus. Reflect with honesty.</h2>
      <div class="pattern-grid">
        <article class="pattern-card agenda-card">
          <h3>Daily agenda</h3>
          <ol>
            <li><time>06:30</time><span class="dot gold"></span><p>Morning review <small>Hydrate · Move · Breathe</small></p></li>
            <li><time>08:00</time><span class="dot violet"></span><p>Deep work block 1 <small>Strategy · Planning</small></p></li>
            <li><time>13:00</time><span class="dot gold"></span><p>Focus block 2 <small>Project execution</small></p></li>
            <li><time>18:00</time><span class="dot rest"></span><p>Wrap up & plan <small>Reflect · Plan tomorrow</small></p></li>
          </ol>
        </article>
        <article class="pattern-card focus-card">
          <h3>Focus mode</h3>
          <button type="button">⚡ Start focus</button>
          <p>50 min · no distractions</p>
        </article>
        <article class="pattern-card progress-card">
          <h3>Progress</h3>
          <div class="ring" aria-label="Weekly progress 76 percent"><strong>76</strong><span>%</span></div>
          <p>Weekly progress<br /><small>Great momentum. Keep going.</small></p>
        </article>
        <article class="pattern-card habit-card">
          <h3>Habit stack</h3>
          <div class="habit-grid">
            <span>✓ Meditate</span><span>✓ Workout</span><span>✓ Read</span><span>○ Journal</span>
          </div>
        </article>
        <article class="pattern-card energy-card">
          <h3>Energy</h3>
          <strong>86%</strong>
          <p>High energy</p>
          <div class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </article>
        <article class="pattern-card week-card">
          <h3>Week overview</h3>
          <div class="week-row">
            {weekDays.map((item) => <span class={item.tone}><b>{item.day}</b><em>{item.value}</em></span>)}
          </div>
        </article>
        <article class="pattern-card milestone-card">
          <h3>Milestone</h3>
          <div class="medal">★</div>
          <p>Strategy doc complete<br /><small>Clarity leads to momentum.</small></p>
        </article>
      </div>
    </section>

    <section class="tone-section" id="tone" aria-labelledby="tone-title">
      <p class="section-code">04 / Tone</p>
      <h2 id="tone-title">Calm.<br />Direct.<br />Honest.<br /><span>Non-performative.</span></h2>
      <div class="tone-list">
        <p><strong>Clarity over noise</strong><span>We remove friction so decisions become obvious.</span></p>
        <p><strong>System, not motivation</strong><span>We build reliable patterns, not temporary spikes.</span></p>
        <p><strong>Intent → Action → Reflection</strong><span>A loop that compounds with time.</span></p>
        <p><strong>Privacy by design</strong><span>Your system is yours. Always.</span></p>
      </div>
    </section>

    <section class="ratio-section" aria-label="60 30 10">
      <div><strong>60%</strong><span>Calm surface</span></div>
      <div><strong>30%</strong><span>Structure</span></div>
      <div><strong>10%</strong><span>Luminous signal</span></div>
    </section>
  </main>

  <footer class="site-footer reflective-footer">
    <a class="wordmark" href={base}>personal<span>ops</span></a>
    <p>System over everything.</p>
  </footer>

  <style is:global>
    :root {
      --po-ink: #1a1715;
      --po-panel: #282321;
      --po-silver: #d8d2c9;
      --po-surface: #f3f0ea;
      --po-violet: #a78bfa;
      --po-gold: #ffc83d;
      --po-success: #37e38c;
      --po-warning: #ff9f1c;
    }

    body.reflective-landing {
      background: radial-gradient(circle at 92% 8%, rgb(167 139 250 / 10%), transparent 24rem), var(--po-surface);
      color: var(--po-ink);
    }
  </style>

  <style>
    .reflective-header,
    .reflective-footer,
    .guide-shell {
      width: min(118rem, calc(100% - 5rem));
      margin-inline: auto;
    }

    .reflective-header {
      min-height: 5.6rem;
      border-color: color-mix(in srgb, var(--po-ink) 18%, transparent);
      text-transform: uppercase;
      letter-spacing: 0.14em;
    }

    .reflective-header .wordmark,
    .reflective-footer .wordmark {
      font-family: var(--font-ui);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      text-transform: lowercase;
    }

    .reflective-header .wordmark span,
    .reflective-footer .wordmark span {
      color: inherit;
    }

    .reflective-header nav a {
      color: var(--po-ink);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .reflective-header .header-action {
      background: var(--po-ink);
      color: var(--po-surface);
    }

    .hero-guide {
      padding: clamp(4rem, 7vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
      border-bottom: 1px solid color-mix(in srgb, var(--po-ink) 18%, transparent);
    }

    .hero-kicker,
    .section-code {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      color: var(--po-ink);
      font-size: clamp(0.7rem, 0.9vw, 0.82rem);
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: clamp(2rem, 8vw, 9rem);
      align-items: center;
      margin-top: clamp(4rem, 9vw, 8rem);
    }

    .hero-grid h1 {
      max-width: 11ch;
      margin-top: 1.4rem;
      font-family: var(--font-display);
      font-size: clamp(4.8rem, 11vw, 12.5rem);
      font-weight: 800;
      letter-spacing: -0.075em;
      line-height: 0.86;
      text-transform: uppercase;
    }

    .hero-lead {
      max-width: 56ch;
      margin-top: 2rem;
      color: color-mix(in srgb, var(--po-ink) 68%, transparent);
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: clamp(1rem, 1.4vw, 1.25rem);
      line-height: 1.8;
    }

    .hero-actions {
      margin-top: 2rem;
    }

    .button-primary {
      border-radius: 0;
      background: var(--po-ink);
      color: var(--po-surface);
      text-transform: none;
    }

    .text-link {
      color: var(--po-ink);
    }

    .plan-mark {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.15rem 1.4rem;
      align-items: start;
      min-width: 12rem;
      text-transform: uppercase;
    }

    .plan-mark strong {
      grid-row: span 4;
      display: grid;
      width: 3rem;
      height: 5rem;
      place-items: center;
      background: var(--po-ink);
      color: var(--po-surface);
      font-size: 2rem;
    }

    .plan-mark span {
      color: color-mix(in srgb, var(--po-ink) 72%, transparent);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.14em;
    }

    .color-system,
    .patterns-section,
    .tone-section,
    .ratio-section {
      padding: clamp(4rem, 7vw, 7rem) 0;
      border-bottom: 1px solid color-mix(in srgb, var(--po-ink) 18%, transparent);
    }

    .color-system h2,
    .patterns-section h2 {
      max-width: 18ch;
      margin-top: 1rem;
      font-family: var(--font-display);
      font-size: clamp(2.6rem, 6vw, 6.2rem);
      font-weight: 760;
      letter-spacing: -0.06em;
      line-height: 0.95;
      text-transform: uppercase;
    }

    .swatch-row {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: clamp(1rem, 2vw, 1.8rem);
      margin-top: clamp(2.5rem, 5vw, 4rem);
    }

    .swatch-row article {
      display: grid;
      gap: 0.45rem;
      min-width: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      text-transform: uppercase;
    }

    .swatch-row i {
      display: block;
      aspect-ratio: 1;
      border: 1px solid color-mix(in srgb, var(--po-ink) 12%, transparent);
    }

    .swatch-row .ink { background: var(--po-ink); }
    .swatch-row .panel { background: var(--po-panel); }
    .swatch-row .surface { background: var(--po-silver); }
    .swatch-row .violet { background: var(--po-violet); }
    .swatch-row .gold { background: var(--po-gold); }
    .swatch-row strong { font-size: 0.78rem; letter-spacing: 0.12em; }
    .swatch-row span { color: color-mix(in srgb, var(--po-ink) 62%, transparent); font-size: 0.75rem; }

    .intent-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.8fr);
      gap: 1rem clamp(2rem, 5vw, 5rem);
      margin-top: clamp(3rem, 6vw, 5rem);
      align-items: center;
    }

    .intent-band {
      display: grid;
      gap: 0.3rem;
      padding: 1.45rem 2rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      text-transform: uppercase;
    }

    .violet-band { background: var(--po-violet); color: white; }
    .gold-band { background: var(--po-gold); color: var(--po-ink); }
    .intent-band span { font-weight: 900; letter-spacing: 0.12em; }
    .intent-band small { letter-spacing: 0.08em; opacity: 0.86; }
    .intent-copy { border-left: 3px solid var(--po-violet); padding-left: 1.2rem; font-size: clamp(1.1rem, 1.7vw, 1.45rem); }
    .intent-copy:nth-of-type(4) { border-left-color: var(--po-gold); }

    .pattern-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr 0.9fr 1fr;
      gap: 1.5rem;
      margin-top: clamp(3rem, 6vw, 5rem);
    }

    .pattern-card {
      min-height: 18rem;
      padding: 1.5rem;
      border: 1px solid color-mix(in srgb, var(--po-ink) 16%, transparent);
      background: rgb(255 255 255 / 28%);
    }

    .pattern-card h3 {
      margin-bottom: 1.4rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.82rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .agenda-card ol { display: grid; gap: 1rem; list-style: none; padding: 0; }
    .agenda-card li { display: grid; grid-template-columns: 3.4rem auto 1fr; gap: 0.8rem; align-items: start; }
    .agenda-card time { color: color-mix(in srgb, var(--po-ink) 56%, transparent); font-variant-numeric: tabular-nums; }
    .dot { width: 0.85rem; height: 0.85rem; margin-top: 0.35rem; border: 2px solid currentColor; border-radius: 50%; }
    .dot.gold { color: var(--po-gold); }
    .dot.violet { color: var(--po-violet); }
    .dot.rest { color: color-mix(in srgb, var(--po-ink) 32%, transparent); }
    .agenda-card small, .progress-card small, .milestone-card small { display: block; color: color-mix(in srgb, var(--po-ink) 55%, transparent); }

    .focus-card,
    .milestone-card {
      background: var(--po-panel);
      color: var(--po-surface);
    }

    .focus-card button {
      width: 100%;
      min-height: 5rem;
      border-radius: 999px;
      background: var(--po-violet);
      color: white;
      cursor: pointer;
      font-size: 1.3rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .focus-card p { margin-top: 1.4rem; color: color-mix(in srgb, white 62%, transparent); text-align: center; text-transform: uppercase; }

    .ring {
      display: grid;
      width: 12rem;
      aspect-ratio: 1;
      place-items: center;
      margin: 0 auto 1.2rem;
      border-radius: 50%;
      background: conic-gradient(var(--po-success) 0 21%, var(--po-gold) 21% 34%, var(--po-violet) 34% 76%, color-mix(in srgb, var(--po-ink) 12%, transparent) 76% 100%);
      position: relative;
    }

    .ring::after {
      content: '';
      position: absolute;
      inset: 1rem;
      border-radius: inherit;
      background: var(--po-surface);
    }

    .ring strong,
    .ring span {
      position: relative;
      z-index: 1;
    }

    .ring strong { font-size: 3.8rem; line-height: 1; }
    .ring span { margin-left: 3.2rem; margin-top: -4.8rem; font-size: 1.1rem; }
    .progress-card p { text-align: center; text-transform: uppercase; }

    .habit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
    .habit-grid span { padding: 0.9rem 1rem; border: 1px solid color-mix(in srgb, var(--po-ink) 14%, transparent); border-radius: 0.35rem; font-weight: 800; text-transform: uppercase; }

    .energy-card strong { display: block; font-size: 4rem; line-height: 1; }
    .energy-card p { color: var(--po-success); font-weight: 900; text-transform: uppercase; }
    .bars { display: flex; align-items: end; gap: 0.35rem; height: 5.5rem; margin-top: 1.6rem; }
    .bars i { flex: 1; background: var(--po-success); }
    .bars i:nth-child(1) { height: 18%; } .bars i:nth-child(2) { height: 28%; } .bars i:nth-child(3) { height: 42%; } .bars i:nth-child(4) { height: 58%; }
    .bars i:nth-child(n + 5) { background: var(--po-gold); } .bars i:nth-child(5) { height: 72%; } .bars i:nth-child(6) { height: 88%; } .bars i:nth-child(7) { height: 74%; } .bars i:nth-child(8) { height: 56%; }

    .week-card { grid-column: span 2; }
    .week-row { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.8rem; }
    .week-row span { display: grid; place-items: center; gap: 0.8rem; padding: 1rem 0.4rem; border: 1px solid color-mix(in srgb, var(--po-ink) 14%, transparent); }
    .week-row b { font-size: 0.8rem; letter-spacing: 0.12em; }
    .week-row em { font-style: normal; font-size: 1.2rem; }
    .week-row .success { color: var(--po-success); } .week-row .violet { color: var(--po-violet); } .week-row .gold { color: var(--po-gold); } .week-row .rest { color: color-mix(in srgb, var(--po-ink) 34%, transparent); }

    .medal { width: 7rem; aspect-ratio: 1; display: grid; place-items: center; margin: 0 auto 1.5rem; border-radius: 50%; background: var(--po-gold); color: var(--po-ink); font-size: 3.4rem; }
    .milestone-card p { text-align: center; color: var(--po-gold); font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; }

    .tone-section {
      display: grid;
      grid-template-columns: minmax(0, 0.78fr) minmax(18rem, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: end;
    }

    .tone-section h2 {
      margin-top: 1rem;
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 7rem);
      font-weight: 720;
      letter-spacing: -0.06em;
      line-height: 0.94;
    }

    .tone-section h2 span { color: var(--po-violet); }
    .tone-list { border-top: 1px solid color-mix(in srgb, var(--po-ink) 18%, transparent); }
    .tone-list p { display: grid; grid-template-columns: minmax(10rem, 0.7fr) 1fr; gap: 1rem; padding: 1.2rem 0; border-bottom: 1px solid color-mix(in srgb, var(--po-ink) 18%, transparent); }
    .tone-list strong { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.78rem; }
    .tone-list span { color: color-mix(in srgb, var(--po-ink) 62%, transparent); }

    .ratio-section {
      display: grid;
      grid-template-columns: 1.4fr 0.9fr 0.55fr;
      padding-bottom: 0;
    }

    .ratio-section div { min-height: 12rem; padding: 2rem; border-right: 1px solid color-mix(in srgb, var(--po-ink) 14%, transparent); }
    .ratio-section div:nth-child(1) { background: color-mix(in srgb, var(--po-surface) 85%, white); }
    .ratio-section div:nth-child(2) { background: var(--po-panel); color: var(--po-surface); }
    .ratio-section div:nth-child(3) { background: var(--po-violet); color: white; }
    .ratio-section strong { display: block; font-size: clamp(3rem, 5vw, 5rem); line-height: 1; }
    .ratio-section span { display: block; margin-top: 0.6rem; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: 0.12em; text-transform: uppercase; }

    .reflective-footer { min-height: 6rem; border-top: 0; color: color-mix(in srgb, var(--po-ink) 62%, transparent); text-transform: uppercase; letter-spacing: 0.12em; }

    @media (max-width: 1024px) {
      .reflective-header,
      .reflective-footer,
      .guide-shell { width: min(100% - 2rem, 118rem); }
      .hero-grid,
      .tone-section { grid-template-columns: 1fr; }
      .plan-mark { justify-self: start; }
      .swatch-row { grid-template-columns: repeat(3, 1fr); }
      .intent-grid { grid-template-columns: 1fr; }
      .pattern-grid { grid-template-columns: 1fr 1fr; }
      .week-card { grid-column: span 2; }
    }

    @media (max-width: 640px) {
      .reflective-header nav a:not(.header-action) { display: none; }
      .hero-grid h1 { font-size: clamp(4rem, 18vw, 7rem); }
      .hero-kicker { display: grid; }
      .swatch-row, .pattern-grid, .week-row, .tone-list p, .ratio-section { grid-template-columns: 1fr; }
      .week-card { grid-column: auto; }
      .pattern-card { min-height: auto; }
      .ratio-section div { min-height: 9rem; border-right: 0; border-bottom: 1px solid color-mix(in srgb, var(--po-ink) 14%, transparent); }
    }
  </style>
</BaseLayout>
