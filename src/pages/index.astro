---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const operatingQuestions = [
  {
    code: '01',
    title: 'O que pede atenção agora?',
    text: 'O dia começa por estado real: energia, capacidade, compromissos, atrasos e bloqueios.',
  },
  {
    code: '02',
    title: 'O que é prioridade de verdade?',
    text: 'Prioridade é resultado com impacto e urgência. Tarefa é apenas o próximo passo executável.',
  },
  {
    code: '03',
    title: 'Quanto cabe sem mentir?',
    text: 'O plano se ajusta ao tempo disponível e à energia percebida, não a uma lista infinita.',
  },
  {
    code: '04',
    title: 'O que avançou e o que muda?',
    text: 'A revisão compara planejado e realizado, registra evidência e transforma leitura em decisão.',
  },
];

const productSurfaces = [
  'Hoje',
  'Prioridades',
  'Tarefas',
  'Compromissos',
  'Rotinas',
  'Energia',
  'Objetivos',
  'Revisões',
  'Histórico',
  'Configurações',
];

const vocabulary = [
  ['Prioridade', 'resultado que merece atenção por impacto e urgência'],
  ['Tarefa', 'próximo passo executável, planejado ou em andamento'],
  ['Compromisso', 'ocupação temporal que disputa capacidade'],
  ['Energia', 'estado percebido de 1 a 5, registrado por período'],
  ['Revisão', 'leitura do planejado versus realizado, seguida de decisão'],
];
---

<BaseLayout
  title="PersonalOps — clareza operacional pessoal"
  description="Sistema pessoal para ler energia, capacidade, prioridades, compromissos e execução antes de transformar o dia em uma lista infinita."
  pageClass="marketing-page personalops-landing"
>
  <header class="site-header product-header">
    <a class="wordmark" href={base} aria-label="PersonalOps, início">personal<span>ops</span></a>
    <nav aria-label="Navegação principal">
      <a href="#sistema">O sistema</a>
      <a href="#produto">Produto</a>
      <a class="header-action" href={`${base}entrar/`}>Entrar</a>
    </nav>
  </header>

  <main id="conteudo" class="product-shell">
    <section class="product-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="product-kicker">PersonalOps / clareza operacional pessoal</p>
        <h1 id="hero-title">PersonalOps organiza decisões antes de organizar listas.</h1>
        <p class="hero-lead">
          Um sistema pessoal para responder o que pede atenção agora, o que realmente é prioridade,
          quanto cabe no dia, o que bloqueia a execução, o que avançou e qual é o próximo passo
          concreto.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${base}entrar/`}>Abrir meu sistema</a>
          <a class="text-link" href="#sistema">Ver como funciona</a>
        </div>
      </div>

      <aside class="ops-card" aria-label="Exemplo de leitura operacional do dia">
        <header>
          <div>
            <span>Hoje</span>
            <strong>sexta, 1 de agosto</strong>
          </div>
          <span class="capacity-pill">capacidade 3/5</span>
        </header>
        <div class="next-step-block">
          <span>Próximo passo</span>
          <p>Fechar a decisão pendente antes de abrir uma nova frente.</p>
        </div>
        <div class="capacity-grid" aria-label="Resumo operacional">
          <div><strong>165</strong><span>min disponíveis</span></div>
          <div><strong>3</strong><span>prioridades reais</span></div>
          <div><strong>1</strong><span>bloqueio ativo</span></div>
        </div>
        <ol class="ops-list">
          <li><span>01</span><strong>Concluir proposta</strong><small>45 min · prioridade alta</small></li>
          <li><span>02</span><strong>Revisar agenda da semana</strong><small>20 min · compromisso</small></li>
          <li><span>03</span><strong>Caminhada leve</strong><small>rotina · energia baixa</small></li>
        </ol>
      </aside>
    </section>

    <section class="thesis-section" id="sistema" aria-labelledby="system-title">
      <div class="section-header">
        <p class="product-kicker">Tese operacional</p>
        <h2 id="system-title">O produto não começa pela interface. Começa pela leitura do dia.</h2>
        <p>
          PersonalOps não é uma lista genérica de tarefas. É uma estrutura para separar resultado,
          ação, tempo, energia e revisão. A interface existe para tornar essa decisão inevitável.
        </p>
      </div>

      <div class="question-grid">
        {operatingQuestions.map((item) => (
          <article>
            <span>{item.code}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="model-section" aria-labelledby="model-title">
      <div>
        <p class="product-kicker">Vocabulário canônico</p>
        <h2 id="model-title">Prioridade, tarefa e compromisso não são a mesma coisa.</h2>
      </div>
      <dl class="vocabulary-list">
        {vocabulary.map(([term, definition]) => (
          <div>
            <dt>{term}</dt>
            <dd>{definition}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="product-section" id="produto" aria-labelledby="product-title">
      <div class="section-header compact">
        <p class="product-kicker">Produto real</p>
        <h2 id="product-title">As superfícies existem para sustentar execução, não para decorar dashboard.</h2>
        <p>
          O workspace autenticado já cobre o ciclo diário: estado, planejamento, execução, revisão,
          histórico e configurações de conta, com persistência real no Supabase.
        </p>
      </div>
      <div class="surface-map" aria-label="Superfícies funcionais do PersonalOps">
        {productSurfaces.map((surface) => <span>{surface}</span>)}
      </div>
    </section>

    <section class="signal-section" aria-labelledby="signal-title">
      <div>
        <p class="product-kicker">Identidade</p>
        <h2 id="signal-title">Calmo para pensar. Estruturado para decidir. Sinalizado só quando importa.</h2>
      </div>
      <div class="ratio-panel" aria-label="Proporção visual de referência 60 30 10">
        <div class="ratio-surface"><strong>60%</strong><span>superfície calma</span></div>
        <div class="ratio-structure"><strong>30%</strong><span>estrutura que sustenta</span></div>
        <div class="ratio-signal"><strong>10%</strong><span>sinal de prioridade</span></div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="cta-title">
      <p class="product-kicker">Sistema, não motivação</p>
      <h2 id="cta-title">Seu dia não precisa de mais ruído. Precisa de uma leitura honesta.</h2>
      <a class="button button-gold" href={`${base}entrar/`}>Começar no PersonalOps</a>
    </section>
  </main>

  <footer class="site-footer product-footer">
    <a class="wordmark" href={base}>personal<span>ops</span></a>
    <p>Sistema pessoal para clareza operacional.</p>
  </footer>
</BaseLayout>

<style>
  .personalops-landing {
    --surface: #f3f0ea;
    --ink-local: #1a1715;
    --panel: #fbfaf7;
    --structure: #d8d2c9;
    --structure-dark-local: #282321;
    --muted: #5f5852;
    --gold-local: #ffc83d;
    --gold-ink: #725000;
  }

  .product-header,
  .product-footer,
  .product-shell {
    width: min(90rem, calc(100% - 3rem));
    margin-inline: auto;
  }

  .product-shell {
    display: grid;
    gap: clamp(5rem, 9vw, 9rem);
  }

  .product-hero {
    display: grid;
    min-height: calc(100svh - 5rem);
    grid-template-columns: minmax(0, 0.95fr) minmax(30rem, 1.05fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
    padding-block: clamp(4rem, 8vw, 7.5rem);
  }

  .product-kicker {
    color: var(--gold-ink);
    font-size: 0.78rem;
    font-weight: 780;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-hero h1,
  .thesis-section h2,
  .model-section h2,
  .product-section h2,
  .signal-section h2,
  .final-cta h2 {
    font-family: var(--font-display);
    font-weight: 610;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .product-hero h1 {
    max-width: 11ch;
    margin-top: 1.15rem;
    font-size: clamp(3.4rem, 7.6vw, 6.8rem);
  }

  .hero-lead {
    max-width: 48ch;
    margin-top: 1.7rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.35vw, 1.28rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
    margin-top: 2rem;
  }

  .ops-card {
    border: 1px solid var(--structure);
    background: var(--panel);
    box-shadow: 0 1.5rem 4rem rgb(26 23 21 / 8%);
  }

  .ops-card header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--structure);
  }

  .ops-card header div {
    display: grid;
    gap: 0.12rem;
  }

  .ops-card header span,
  .ops-card small {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .capacity-pill {
    padding: 0.35rem 0.55rem;
    border-radius: 999px;
    background: #ece6dc;
    color: var(--structure-dark-local) !important;
    font-weight: 700;
  }

  .next-step-block {
    padding: 1.4rem 1.2rem;
    background: var(--ink-local);
    color: var(--surface);
  }

  .next-step-block span {
    color: var(--gold-local);
    font-size: 0.72rem;
    font-weight: 780;
    text-transform: uppercase;
  }

  .next-step-block p {
    max-width: 34ch;
    margin-top: 0.5rem;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.35;
  }

  .capacity-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--structure);
  }

  .capacity-grid div {
    padding: 1rem;
    border-right: 1px solid var(--structure);
  }

  .capacity-grid div:last-child {
    border-right: 0;
  }

  .capacity-grid strong {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
  }

  .capacity-grid span {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .ops-list {
    list-style: none;
    padding: 0;
  }

  .ops-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.2rem 0.85rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--structure);
  }

  .ops-list li:last-child {
    border-bottom: 0;
    background: var(--surface);
  }

  .ops-list li > span {
    grid-row: span 2;
    color: var(--gold-ink);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .section-header {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 0.95fr) minmax(18rem, 0.7fr);
    gap: 2rem;
    align-items: start;
    padding-top: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--structure);
  }

  .section-header.compact {
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1fr) minmax(18rem, 0.8fr);
  }

  .section-header h2,
  .model-section h2,
  .signal-section h2,
  .final-cta h2 {
    font-size: clamp(2.4rem, 5vw, 5rem);
  }

  .section-header p:last-child,
  .product-section .section-header p:last-child {
    max-width: 44ch;
    color: var(--muted);
    font-size: 1.03rem;
    line-height: 1.65;
  }

  .question-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 4rem;
    border-top: 1px solid var(--structure);
    border-bottom: 1px solid var(--structure);
  }

  .question-grid article {
    min-height: 20rem;
    padding: 1.25rem;
    border-right: 1px solid var(--structure);
  }

  .question-grid article:last-child {
    border-right: 0;
  }

  .question-grid span {
    color: var(--gold-ink);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  .question-grid h3 {
    margin-top: 7rem;
    font-size: 1.3rem;
    letter-spacing: -0.025em;
  }

  .question-grid p {
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .model-section,
  .signal-section {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(28rem, 1.1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
    padding-top: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--structure);
  }

  .model-section h2,
  .signal-section h2 {
    max-width: 12ch;
    margin-top: 1rem;
  }

  .vocabulary-list {
    border-top: 1px solid var(--structure);
  }

  .vocabulary-list div {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--structure);
  }

  .vocabulary-list dt {
    font-weight: 760;
  }

  .vocabulary-list dd {
    color: var(--muted);
  }

  .surface-map {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin-top: 3rem;
    border-top: 1px solid var(--structure);
    border-left: 1px solid var(--structure);
  }

  .surface-map span {
    min-height: 7.5rem;
    padding: 1rem;
    border-right: 1px solid var(--structure);
    border-bottom: 1px solid var(--structure);
    background: color-mix(in srgb, var(--panel) 64%, var(--surface));
    font-weight: 720;
  }

  .ratio-panel {
    display: grid;
    grid-template-columns: 6fr 3fr 1fr;
    min-height: 11rem;
    border: 1px solid var(--structure);
  }

  .ratio-panel div {
    display: grid;
    align-content: end;
    padding: 1.2rem;
  }

  .ratio-panel strong {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5vw, 4rem);
    line-height: 1;
  }

  .ratio-panel span {
    margin-top: 0.35rem;
    font-size: 0.78rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ratio-surface {
    background: var(--surface);
  }

  .ratio-structure {
    background: var(--structure-dark-local);
    color: var(--surface);
  }

  .ratio-signal {
    background: var(--gold-local);
    color: var(--ink-local);
  }

  .final-cta {
    width: min(58rem, 100%);
    margin-inline: auto;
    padding-block: clamp(5rem, 10vw, 9rem);
    text-align: center;
  }

  .final-cta h2 {
    margin: 0.65rem auto 2rem;
  }

  @media (max-width: 1024px) {
    .product-hero,
    .model-section,
    .signal-section {
      grid-template-columns: 1fr;
    }

    .ops-card {
      max-width: 48rem;
    }

    .section-header,
    .section-header.compact {
      grid-template-columns: 1fr 1.5fr;
    }

    .section-header p:last-child {
      grid-column: 2;
    }

    .question-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .question-grid article:nth-child(2n) {
      border-right: 0;
    }

    .question-grid article:nth-child(-n + 2) {
      border-bottom: 1px solid var(--structure);
    }

    .surface-map {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .product-header,
    .product-footer,
    .product-shell {
      width: min(100% - 2rem, 90rem);
    }

    .product-header nav a:not(.header-action) {
      display: none;
    }

    .product-hero {
      min-height: auto;
      padding-block: 4.5rem 5rem;
    }

    .product-hero h1 {
      font-size: clamp(3rem, 14vw, 4.8rem);
    }

    .section-header,
    .section-header.compact,
    .model-section,
    .signal-section {
      grid-template-columns: 1fr;
    }

    .section-header p:last-child {
      grid-column: auto;
    }

    .question-grid,
    .surface-map,
    .capacity-grid {
      grid-template-columns: 1fr;
    }

    .question-grid article,
    .question-grid article:nth-child(2n),
    .capacity-grid div {
      border-right: 0;
      border-bottom: 1px solid var(--structure);
    }

    .question-grid article:last-child,
    .capacity-grid div:last-child {
      border-bottom: 0;
    }

    .question-grid h3 {
      margin-top: 3.5rem;
    }

    .vocabulary-list div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .ratio-panel {
      grid-template-columns: 1fr;
    }

    .ratio-panel div {
      min-height: 7rem;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-actions .text-link {
      text-align: center;
    }

    .ops-card header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
