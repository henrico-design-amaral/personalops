---
import BaseLayout from '../../layouts/BaseLayout.astro';
const target = `${import.meta.env.BASE_URL}app/hoje/`;
---

<BaseLayout title="Abrindo o PersonalOps" pageClass="app-page" robots="noindex,nofollow">
  <main id="conteudo" class="app-loading">
    <div class="loading-panel">
      <div class="loading-mark" aria-hidden="true"></div><h1>Abrindo o PersonalOps</h1><p>
        <a href={target}>Continuar para Hoje</a>
      </p>
    </div>
  </main>
  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</BaseLayout>
