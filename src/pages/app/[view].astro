---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonalOpsApp from '../../components/app/PersonalOpsApp';
import type { AppView } from '../../lib/domain/types';

export function getStaticPaths() {
  return [
    'hoje',
    'prioridades',
    'tarefas',
    'rotinas',
    'objetivos',
    'revisoes',
    'historico',
    'configuracoes',
  ].map((view) => ({ params: { view } }));
}

const view = Astro.params.view as AppView;
---

<BaseLayout
  title={`${view.charAt(0).toUpperCase() + view.slice(1)} — PersonalOps`}
  description="Workspace pessoal protegido."
  pageClass="app-page"
  robots="noindex,nofollow"
>
  <PersonalOpsApp client:load initialView={view} basePath={import.meta.env.BASE_URL} />
</BaseLayout>
