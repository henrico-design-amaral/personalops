---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Recuperar acesso — PersonalOps"
  description="Recupere o acesso ao PersonalOps."
  pageClass="auth-page"
  robots="noindex,nofollow"
>
  <main id="conteudo" class="auth-shell compact" data-base={base}>
    <a class="wordmark auth-brand" href={base}>personal<span>ops</span></a>
    <section class="auth-panel compact" aria-labelledby="recovery-title">
      <div class="auth-copy">
        <p class="signal-label">Recuperação de acesso</p>
        <h1 id="recovery-title">Volte ao seu sistema.</h1>
        <p data-recovery-copy>Enviaremos um link seguro para redefinir sua senha.</p>
      </div>
      <div class="auth-form-wrap">
        <form id="recovery-form" novalidate>
          <div class="field" data-email-field>
            <label for="email">E-mail</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field" data-password-field hidden>
            <label for="new-password">Nova senha</label>
            <input
              id="new-password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="8"
            />
          </div>
          <button class="button button-primary auth-submit" type="submit"
            >Enviar link de recuperação</button
          >
          <p class="form-message" id="recovery-message" role="status" aria-live="polite"></p>
        </form>
        <a class="text-link reset-link" href={`${base}entrar/`}>Voltar para entrar</a>
      </div>
    </section>
  </main>
  <script>
    import { getSupabase } from '../lib/supabase/client';
    const shell = document.querySelector<HTMLElement>('[data-base]');
    const base = shell?.dataset.base ?? '/';
    const form = document.querySelector<HTMLFormElement>('#recovery-form');
    const message = document.querySelector<HTMLElement>('#recovery-message');
    const submit = document.querySelector<HTMLButtonElement>('.auth-submit');
    const emailField = document.querySelector<HTMLElement>('[data-email-field]');
    const passwordField = document.querySelector<HTMLElement>('[data-password-field]');
    const recoveryMode =
      new URLSearchParams(window.location.search).get('type') === 'recovery' ||
      window.location.hash.includes('type=recovery');

    if (recoveryMode) {
      if (emailField) emailField.hidden = true;
      if (passwordField) passwordField.hidden = false;
      const password = form?.elements.namedItem('password');
      if (password instanceof HTMLInputElement) password.required = true;
      if (submit) submit.textContent = 'Salvar nova senha';
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !submit || !message) return;
      const values = new FormData(form);
      submit.disabled = true;
      message.textContent = '';
      try {
        if (recoveryMode) {
          const { error } = await getSupabase().auth.updateUser({
            password: String(values.get('password') ?? ''),
          });
          if (error) throw error;
          message.textContent = 'Senha atualizada. Redirecionando…';
          setTimeout(() => window.location.assign(`${base}app/hoje/`), 700);
        } else {
          const email = String(values.get('email') ?? '').trim();
          const redirectTo = new URL(
            `${base}recuperar/?type=recovery`,
            window.location.origin,
          ).toString();
          const { error } = await getSupabase().auth.resetPasswordForEmail(email, { redirectTo });
          if (error) throw error;
          message.textContent = 'Se o e-mail existir, o link será enviado em instantes.';
          submit.disabled = false;
          submit.textContent = 'Enviar novamente';
        }
      } catch (error) {
        message.textContent =
          error instanceof Error ? error.message : 'Não foi possível concluir a recuperação.';
        submit.disabled = false;
      }
    });
  </script>
</BaseLayout>
