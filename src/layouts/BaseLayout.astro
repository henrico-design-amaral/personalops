---
import '@fontsource-variable/inter';
import '@fontsource-variable/syne';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  robots?: string;
}

const {
  title = 'PersonalOps',
  description = 'Sistema pessoal para clareza, capacidade e execução diária.',
  pageClass = '',
  robots = 'index,follow',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151313" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <slot />
  </body>
</html>
